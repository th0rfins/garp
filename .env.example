# GARP self-hosted — environment
# Copy to .env and adjust (Docker: set these in docker-compose.yml instead).

# Port HTTP server (Server membaca SERVER_PORT dulu, lalu PORT, fallback 3000)
PORT=3000

# Where the SQLite file lives (default: ./data/garp.db relative to app dir)
# Docker: default /data (volume terpasang di sana)
GARP_DATA_DIR=/data

# Timezone used for "today" and daily stats (UI is WIB)
TZ=Asia/Jakarta

# Used only by scripts/import-from-live.mjs
#GARP_LIVE_URL=https://rtu3oi0i4ati9lmob1c55k4a.sin.prisma.build
